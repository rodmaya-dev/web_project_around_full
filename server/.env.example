# Clave para firmar los tokens. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'));"
JWT_SECRET=cambia-esto-por-una-clave-de-64-caracteres-hexadecimales

# Cadena de conexión de MongoDB, con el nombre de la base antes del "?"
MONGODB_URI=mongodb://localhost:27017/aroundb

# Puerto donde escucha el servidor (opcional: por defecto 3001)
PORT=3001

# Dirección del front end, sin barra final
CLIENT_ORIGIN=http://localhost:3000